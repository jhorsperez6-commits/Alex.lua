-- ========== ESP ==========
local espBoxes = {}
local espTracers = {}
local MAX_DISTANCE = 400

local function isVisible(targetChar)
	local camera = workspace.CurrentCamera
	if not camera or not targetChar or not targetChar:FindFirstChild("HumanoidRootPart") then return false end
	
	local origin = camera.CFrame.Position
	local target = targetChar.HumanoidRootPart.Position + Vector3.new(0, 1.5, 0)
	local direction = (target - origin)

	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	raycastParams.FilterDescendantsInstances = {LocalPlayer.Character, targetChar}

	local result = workspace:Raycast(origin, direction, raycastParams)
	return result == nil or (result.Instance and result.Instance:IsDescendantOf(targetChar))
end

local function cleanupESP()
	for _, box in pairs(espBoxes) do pcall(function() box:Remove() end) end
	for _, tracer in pairs(espTracers) do pcall(function() tracer:Remove() end) end
	espBoxes = {}
	espTracers = {}
end

local function getClosestVisibleEnemyHead()
	local closest = nil
	local shortest = math.huge
	local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not myRoot then return nil end

	for _, player in pairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and not isTeammate(player) then
			local char = player.Character
			if char and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 and char:FindFirstChild("Head") then
				if isVisible(char) then
					local dist = (myRoot.Position - char.Head.Position).Magnitude
					if dist < shortest and dist < 400 then
						shortest = dist
						closest = char.Head
					end
				end
			end
		end
	end
	return closest
end

-- ========== LOOPS ==========
RunService.RenderStepped:Connect(function()
	if not espEnabled then
		cleanupESP()
	else
		local currentPlayers = {}
		local myChar = LocalPlayer.Character
		local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
		local camera = workspace.CurrentCamera

		for _, player in pairs(Players:GetPlayers()) do
			if player ~= LocalPlayer and not isTeammate(player) and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
				
				local hrp = player.Character.HumanoidRootPart
				local distance = myRoot and (myRoot.Position - hrp.Position).Magnitude or 9999

				if distance <= MAX_DISTANCE then
					currentPlayers[player] = true
					
					local headPos = hrp.Position + Vector3.new(0, 1.5, 0)
					local pos, onScreen = camera:WorldToViewportPoint(headPos)
					
					if onScreen and pos.Z > 0 then
						if not espBoxes[player] then
							local box = Drawing.new("Square")
							box.Thickness = 1.8
							box.Filled = false
							box.Visible = false
							espBoxes[player] = box

							local tracer = Drawing.new("Line")
							tracer.Thickness = 1.6
							tracer.Visible = false
							espTracers[player] = tracer
						end

						local box = espBoxes[player]
						local tracer = espTracers[player]
						
						local size = math.clamp(1800 / pos.Z, 18, 55)
						local visible = isVisible(player.Character)
						local color = visible and Color3.fromRGB(0, 255, 80) or Color3.fromRGB(255, 40, 40)

						box.Size = Vector2.new(size, size * 1.7)
						box.Position = Vector2.new(pos.X - size/2, pos.Y - size * 0.9)
						box.Color = color
						box.Visible = true

						local screenSize = camera.ViewportSize
						tracer.From = Vector2.new(screenSize.X / 2, screenSize.Y)
						tracer.To = Vector2.new(pos.X, pos.Y + size * 0.3)
						tracer.Color = color
						tracer.Visible = true
					else
						if espBoxes[player] then espBoxes[player].Visible = false end
						if espTracers[player] then espTracers[player].Visible = false end
					end
				end
			end
		end

		for player, box in pairs(espBoxes) do
			if not currentPlayers[player] then
				pcall(function() box:Remove() end)
				espBoxes[player] = nil
				if espTracers[player] then
					pcall(function() espTracers[player]:Remove() end)
					espTracers[player] = nil
				end
			end
		end
	end

	if aimbotEnabled then
		local target = getClosestVisibleEnemyHead()
		if target then
			local cam = workspace.CurrentCamera
			local goal = CFrame.new(cam.CFrame.Position, target.Position)
			cam.CFrame = cam.CFrame:Lerp(goal, 0.48)
		end
	end
end)

RunService.Heartbeat:Connect(function()
	local char = LocalPlayer.Character
	if not char then return end

	if speedEnabled and char:FindFirstChild("Humanoid") then
		char.Humanoid.WalkSpeed = currentSpeed
	elseif char:FindFirstChild("Humanoid") then
		char.Humanoid.WalkSpeed = 16
	end

	if noclipEnabled then
		for _, part in pairs(char:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = false
			end
		end
	end

	if autoStickPlayer then
		if autoStickPlayer.Character 
			and autoStickPlayer.Character:FindFirstChild("HumanoidRootPart")
			and autoStickPlayer.Character:FindFirstChild("Humanoid")
			and autoStickPlayer.Character.Humanoid.Health > 0
			and not isTeammate(autoStickPlayer) then
			
			if char:FindFirstChild("HumanoidRootPart") then
				char.HumanoidRootPart.CFrame = autoStickPlayer.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 1.8)
			end
		else
			autoStickPlayer = nil
		end
	end

	if hitboxEnabled then
		for _, player in pairs(Players:GetPlayers()) do
			if player ~= LocalPlayer and not isTeammate(player) then
				local pChar = player.Character
				if pChar and pChar:FindFirstChild("Humanoid") and pChar.Humanoid.Health > 0 then
					local head = pChar:FindFirstChild("Head")
					local hrp = pChar:FindFirstChild("HumanoidRootPart")
					
					if head and hrp then
						if not originalSizes[player] then
							originalSizes[player] = {
								Head = head.Size,
								HRP = hrp.Size
							}
						end
						
						head.Size = Vector3.new(7.5, 7.5, 7.5)
						head.Transparency = 0.45
						head.CanCollide = false
						head.Massless = true
						
						hrp.Size = Vector3.new(5.5, 5.5, 5.5)
						hrp.Transparency = 0.65
						hrp.CanCollide = false
						hrp.Massless = true
					end
				end
			end
		end
	end
end)

