-- Script: Alex Animation + Cartel de Mantenimiento
-- Autor: para ti

local Players = game:GetService("Players")
local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")

-- ====== ANIMACIÓN “Alex” ======
local animation = Instance.new("Animation")
animation.Name = "Alex"
animation.AnimationId = "rbxassetid://0" -- <-- Cambia este ID por el de tu animación real

local animTrack = humanoid:LoadAnimation(animation)

-- ====== CARTEL GRANDE ======
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "MantenimientoGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0.7, 0, 0.35, 0)
frame.Position = UDim2.new(0.15, 0, 0.325, 0)
frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
frame.BackgroundTransparency = 0.15
frame.BorderSizePixel = 0
frame.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 18)
corner.Parent = frame

local stroke = Instance.new("UIStroke")
stroke.Thickness = 3
stroke.Color = Color3.fromRGB(255, 80, 80)
stroke.Parent = frame

local titulo = Instance.new("TextLabel")
titulo.Size = UDim2.new(1, 0, 0.4, 0)
titulo.Position = UDim2.new(0, 0, 0.1, 0)
titulo.BackgroundTransparency = 1
titulo.Text = "MENÚ EN MANTENIMIENTO"
titulo.TextColor3 = Color3.fromRGB(255, 80, 80)
titulo.TextScaled = true
titulo.Font = Enum.Font.GothamBold
titulo.Parent = frame

local subtitulo = Instance.new("TextLabel")
subtitulo.Size = UDim2.new(0.9, 0, 0.35, 0)
subtitulo.Position = UDim2.new(0.05, 0, 0.5, 0)
subtitulo.BackgroundTransparency = 1
subtitulo.Text = "Por arreglos"
subtitulo.TextColor3 = Color3.fromRGB(255, 255, 255)
subtitulo.TextScaled = true
subtitulo.Font = Enum.Font.Gotham
subtitulo.Parent = frame

-- Ocultar el cartel al principio
screenGui.Enabled = false

-- ====== FUNCIÓN PRINCIPAL ======
local function reproducirAlex()
	-- Mostrar el cartel
	screenGui.Enabled = true
	
	-- Reproducir la animación
	animTrack:Play()
	
	-- Opcional: ocultar el cartel después de unos segundos
	task.wait(5)
	screenGui.Enabled = false
end

-- Ejecutar cuando el personaje carga
reproducirAlex()

-- Si el personaje muere y respawnea, volver a ejecutarlo
player.CharacterAdded:Connect(function(newChar)
	character = newChar
	humanoid = character:WaitForChild("Humanoid")
	animTrack = humanoid:LoadAnimation(animation)
	task.wait(1)
	reproducirAlex()
end)
