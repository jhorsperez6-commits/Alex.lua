-- ====================== FUNCIONES ======================
local function openMenu()
	if open then return end
	open = true
	Main.Visible = true
	Main.Size = UDim2.new(0, 0, 0, 0)
	Main.BackgroundTransparency = 1

	TweenService:Create(Main, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Size = UDim2.new(0, 240, 0, 155),
		BackgroundTransparency = 0
	}):Play()
end

local function closeMenu()
	if not open then return end
	open = false

	TweenService:Create(Main, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		Size = UDim2.new(0, 0, 0, 0),
		BackgroundTransparency = 1
	}):Play()

	task.delay(0.25, function()
		Main.Visible = false
	end)
end

CloseBtn.MouseButton1Click:Connect(closeMenu)

-- Toggle con animación
ToggleBtn.MouseButton1Click:Connect(function()
	autoTP = not autoTP

	if autoTP then
		TweenService:Create(ToggleBtn, TweenInfo.new(0.2), {
			BackgroundColor3 = Color3.fromRGB(0, 180, 90)
		}):Play()
		ToggleBtn.Text = "ON"
		ToggleBtn.TextColor3 = Color3.new(1,1,1)
	else
		TweenService:Create(ToggleBtn, TweenInfo.new(0.2), {
			BackgroundColor3 = Color3.fromRGB(55, 55, 65)
		}):Play()
		ToggleBtn.Text = "OFF"
		ToggleBtn.TextColor3 = Color3.fromRGB(200, 200, 210)
	end
end)

-- Abrir escribiendo "Alex"
LocalPlayer.Chatted:Connect(function(msg)
	local text = string.lower(string.gsub(msg, "%s+", ""))
	if text == "alex" then
		if open then
			closeMenu()
		else
			openMenu()
		end
	end
end)

-- Loop Auto Teleport
RunService.Heartbeat:Connect(function()
	if autoTP then
		local char = LocalPlayer.Character
		if char and char:FindFirstChild("HumanoidRootPart") then
			char.HumanoidRootPart.CFrame = CFrame.new(TARGET)
		end
	end
end)

