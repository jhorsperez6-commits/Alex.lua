-- ====================== UTILIDADES ======================
local function playSound(id, vol)
	local s = Instance.new("Sound")
	s.SoundId = "rbxassetid://" .. tostring(id)
	s.Volume = vol or 0.4
	s.Parent = SoundService
	s:Play()
	game:GetService("Debris"):AddItem(s, 2)
end

local function notify(title, text, color)
	playSound(4590657391, 0.35)
	local gui = LocalPlayer:FindFirstChild("PlayerGui")
	if not gui then return end

	local n = Instance.new("Frame")
	n.Size = UDim2.new(0, 270, 0, 70)
	n.Position = UDim2.new(1, 50, 0, 40)
	n.BackgroundColor3 = Color3.fromRGB(16, 16, 22)
	n.Parent = gui
	Instance.new("UICorner", n).CornerRadius = UDim.new(0, 14)

	local stroke = Instance.new("UIStroke")
	stroke.Color = color or Color3.fromRGB(0, 190, 255)
	stroke.Thickness = 1.6
	stroke.Parent = n

	local t1 = Instance.new("TextLabel")
	t1.Size = UDim2.new(1, -20, 0, 26)
	t1.Position = UDim2.new(0, 12, 0, 10)
	t1.BackgroundTransparency = 1
	t1.Text = title
	t1.TextColor3 = color or Color3.fromRGB(0, 190, 255)
	t1.Font = Enum.Font.GothamBold
	t1.TextSize = 15
	t1.TextXAlignment = Enum.TextXAlignment.Left
	t1.Parent = n

	local t2 = Instance.new("TextLabel")
	t2.Size = UDim2.new(1, -20, 0, 24)
	t2.Position = UDim2.new(0, 12, 0, 36)
	t2.BackgroundTransparency = 1
	t2.Text = text
	t2.TextColor3 = Color3.fromRGB(210, 210, 220)
	t2.Font = Enum.Font.Gotham
	t2.TextSize = 13
	t2.TextXAlignment = Enum.TextXAlignment.Left
	t2.Parent = n

	-- Animación de entrada
	n.BackgroundTransparency = 1
	stroke.Transparency = 1
	t1.TextTransparency = 1
	t2.TextTransparency = 1

	TweenService:Create(n, TweenInfo.new(0.45, Enum.EasingStyle.Quint), {
		Position = UDim2.new(1, -290, 0, 40),
		BackgroundTransparency = 0
	}):Play()
	TweenService:Create(stroke, TweenInfo.new(0.45), {Transparency = 0}):Play()
	TweenService:Create(t1, TweenInfo.new(0.45), {TextTransparency = 0}):Play()
	TweenService:Create(t2, TweenInfo.new(0.45), {TextTransparency = 0}):Play()

	task.delay(3, function()
		TweenService:Create(n, TweenInfo.new(0.35), {
			Position = UDim2.new(1, 50, 0, 40),
			BackgroundTransparency = 1
		}):Play()
		TweenService:Create(stroke, TweenInfo.new(0.35), {Transparency = 1}):Play()
		TweenService:Create(t1, TweenInfo.new(0.35), {TextTransparency = 1}):Play()
		TweenService:Create(t2, TweenInfo.new(0.35), {TextTransparency = 1}):Play()
		task.wait(0.4)
		n:Destroy()
	end)
end

