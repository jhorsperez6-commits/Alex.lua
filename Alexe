-- ====================== TOGGLE ======================
local function createToggle(text, y, callback)
	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(1, -24, 0, 48)
	frame.Position = UDim2.new(0, 12, 0, y)
	frame.BackgroundColor3 = Color3.fromRGB(26, 26, 34)
	frame.Parent = Main
	Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 12)

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(0.65, 0, 1, 0)
	label.Position = UDim2.new(0.04, 0, 0, 0)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = Color3.fromRGB(235, 235, 240)
	label.Font = Enum.Font.GothamMedium
	label.TextSize = 15
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = frame

	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0, 58, 0, 30)
	btn.Position = UDim2.new(1, -72, 0.5, -15)
	btn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
	btn.Text = "OFF"
	btn.TextColor3 = Color3.fromRGB(190, 190, 200)
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 13
	btn.Parent = frame
	Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)

	local on = false
	btn.MouseButton1Click:Connect(function()
		on = not on
		if on then
			TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(0, 185, 95)}):Play()
			btn.Text = "ON"
			btn.TextColor3 = Color3.new(1,1,1)
		else
			TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(50, 50, 60)}):Play()
			btn.Text = "OFF"
			btn.TextColor3 = Color3.fromRGB(190, 190, 200)
		end
		if callback then callback(on) end
	end)
end

createToggle("Infinite Jump", 64, function(v) infiniteJump = v end)
createToggle("Velocidad (300)", 120, function(v) speedOn = v end)
createToggle("Noclip", 176, function(v) noclip = v end)
createToggle("Fly", 232, function(v)
	fly = v
	local char = LocalPlayer.Character
	if not char then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChild("Humanoid")
	if not root or not hum then return end

	if v then
		bodyVel = Instance.new("BodyVelocity")
		bodyVel.MaxForce = Vector3.new(9e9, 9e9, 9e9)
		bodyVel.Velocity = Vector3.zero
		bodyVel.Parent = root
		hum.PlatformStand = true
	else
		if bodyVel then bodyVel:Destroy() bodyVel = nil end
		hum.PlatformStand = false
	end
end)

