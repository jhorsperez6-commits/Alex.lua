-- ========== FUNCIONES ==========
local function isVisible(char)
	local cam = workspace.CurrentCamera
	if not cam or not char or not char:FindFirstChild("HumanoidRootPart") then return false end
	local origin = cam.CFrame.Position
	local target = char.HumanoidRootPart.Position + Vector3.new(0, 1.5, 0)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {LocalPlayer.Character, char}
	local result = workspace:Raycast(origin, target - origin, params)
	return result == nil or (result.Instance and result.Instance:IsDescendantOf(char))
end

local function getClosestEnemy()
	local closest, shortest = nil, math.huge
	for _, player in pairs(Players:GetPlayers()) do
		if isEnemy(player) and player.Character and player.Character:FindFirstChild("Head") and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
			local pos, onScreen = Camera:WorldToViewportPoint(player.Character.Head.Position)
			local dist = (Vector2.new(pos.X, pos.Y) - Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)).Magnitude
			if dist < shortest then
				shortest = dist
				closest = player
			end
		end
	end
	return closest
end

-- Aimbot suave
RunService.RenderStepped:Connect(function()
	if aimbotEnabled then
		local target = getClosestEnemy()
		if target and target.Character and target.Character:FindFirstChild("Head") then
			local goal = CFrame.new(Camera.CFrame.Position, target.Character.Head.Position)
			Camera.CFrame = Camera.CFrame:Lerp(goal, 0.35)
		end
	end

	-- ESP
	if espEnabled then
		local current = {}
		local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
		for _, player in pairs(Players:GetPlayers()) do
			if isEnemy(player) and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
				local hrp = player.Character.HumanoidRootPart
				local dist = myRoot and (myRoot.Position - hrp.Position).Magnitude or 999
				if dist < 500 then
					current[player] = true
					local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position + Vector3.new(0, 1.5, 0))
					if onScreen and pos.Z > 0 then
						if not espBoxes[player] then
							espBoxes[player] = Drawing.new("Square")
							espBoxes[player].Thickness = 1.8
							espBoxes[player].Filled = false
							espTracers[player] = Drawing.new("Line")
							espTracers[player].Thickness = 1.5
						end
						local size = math.clamp(1800 / pos.Z, 18, 55)
						local visible = isVisible(player.Character)
						local color = visible and Color3.fromRGB(0, 255, 80) or Color3.fromRGB(255, 40, 40)

						espBoxes[player].Size = Vector2.new(size, size * 1.7)
						espBoxes[player].Position = Vector2.new(pos.X - size/2, pos.Y - size * 0.9)
						espBoxes[player].Color = color
						espBoxes[player].Visible = true

						espTracers[player].From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
						espTracers[player].To = Vector2.new(pos.X, pos.Y + size * 0.3)
						espTracers[player].Color = color
						espTracers[player].Visible = true
					end
				end
			end
		end
		for player, box in pairs(espBoxes) do
			if not current[player] then
				pcall(function() box:Remove() end)
				espBoxes[player] = nil
				if espTracers[player] then
					pcall(function() espTracers[player]:Remove() end)
					espTracers[player] = nil
				end
			end
		end
	end
end)

-- Heartbeat
RunService.Heartbeat:Connect(function()
	local char = LocalPlayer.Character
	if not char then return end

	if char:FindFirstChild("Humanoid") then
		char.Humanoid.WalkSpeed = currentSpeed
	end

	if noclipEnabled then
		for _, p in pairs(char:GetDescendants()) do
			if p:IsA("BasePart") then p.CanCollide = false end
		end
	end

	if hitboxEnabled then
		local myRoot = char:FindFirstChild("HumanoidRootPart")
		for _, player in pairs(Players:GetPlayers()) do
			if isEnemy(player) and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
				local root = player.Character.HumanoidRootPart
				local head = player.Character:FindFirstChild("Head")
				local dist = myRoot and (myRoot.Position - root.Position).Magnitude or 999

				-- Solo aplica hitbox si está dentro de la distancia
				if dist <= hitboxDistance then
					if not originalSizes[player] then
						originalSizes[player] = {root = root.Size, rootTrans = root.Transparency, head = head and head.Size}
					end
					root.Size = Vector3.new(hitboxSize, hitboxSize * 1.15, hitboxSize)
					root.Transparency = hitboxTransparency
					root.Color = hitboxColor
					root.Material = Enum.Material.Neon
					root.CanCollide = false
					if head then
						head.Size = Vector3.new(hitboxSize * 0.6, hitboxSize * 0.6, hitboxSize * 0.6)
						head.Transparency = hitboxTransparency
						head.Color = hitboxColor
					end
				else
					-- Si se aleja, restaurar tamaño original
					if originalSizes[player] then
						pcall(function()
							root.Size = originalSizes[player].root
							root.Transparency = originalSizes[player].rootTrans or 0
							root.Color = Color3.fromRGB(163, 162, 165)
							root.Material = Enum.Material.Plastic
							if head and originalSizes[player].head then
								head.Size = originalSizes[player].head
								head.Transparency = 0
							end
						end)
						originalSizes[player] = nil
					end
				end
			end
		end
	end

	if autoStickPlayer and autoStickPlayer.Character and autoStickPlayer.Character:FindFirstChild("HumanoidRootPart") then
		if char:FindFirstChild("HumanoidRootPart") then
			char.HumanoidRootPart.CFrame = autoStickPlayer.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3.5)
		end
	end
end)

