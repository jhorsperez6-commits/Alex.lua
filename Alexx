local function isVisible(char)
	if not char or not char:FindFirstChild("HumanoidRootPart") then return false end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {LocalPlayer.Character, char}
	local result = workspace:Raycast(Camera.CFrame.Position, (char.HumanoidRootPart.Position + Vector3.new(0,1.5,0)) - Camera.CFrame.Position, params)
	return result == nil or (result.Instance and result.Instance:IsDescendantOf(char))
end

RunService.RenderStepped:Connect(function()
	if aimbotEnabled then
		local closest, short = nil, math.huge
		for _, plr in pairs(Players:GetPlayers()) do
			if isEnemy(plr) and plr.Character and plr.Character:FindFirstChild("Head") and plr.Character.Humanoid.Health > 0 then
				local pos = Camera:WorldToViewportPoint(plr.Character.Head.Position)
				local d = (Vector2.new(pos.X, pos.Y) - Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)).Magnitude
				if d < short then short = d closest = plr end
			end
		end
		if closest and closest.Character and closest.Character:FindFirstChild("Head") then
			Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, closest.Character.Head.Position), 0.38)
		end
	end

	if espEnabled then
		local current = {}
		local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
		for _, plr in pairs(Players:GetPlayers()) do
			if isEnemy(plr) and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and plr.Character:FindFirstChild("Head") and plr.Character.Humanoid.Health > 0 then
				local hrp = plr.Character.HumanoidRootPart
				local head = plr.Character.Head
				local dist = myRoot and (myRoot.Position - hrp.Position).Magnitude or 999
				if dist <= 200 then
					local headPos, onScreen = Camera:WorldToViewportPoint(head.Position)
					local rootPos = Camera:WorldToViewportPoint(hrp.Position)
					if onScreen and headPos.Z > 0 then
						current[plr] = true
						if not espBoxes[plr] then
							espBoxes[plr] = Drawing.new("Square")
							espBoxes[plr].Thickness = 1.8
							espBoxes[plr].Filled = false
							espTracers[plr] = Drawing.new("Line")
							espTracers[plr].Thickness = 1.5
						end
						local height = math.abs(headPos.Y - rootPos.Y) * 2.2
						local width = height / 1.8
						local col = isVisible(plr.Character) and Color3.fromRGB(0, 255, 90) or Color3.fromRGB(255, 45, 45)
						espBoxes[plr].Size = Vector2.new(width, height)
						espBoxes[plr].Position = Vector2.new(headPos.X - width/2, headPos.Y - height * 0.15)
						espBoxes[plr].Color = col
						espBoxes[plr].Visible = true
						espTracers[plr].From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
						espTracers[plr].To = Vector2.new(headPos.X, headPos.Y)
						espTracers[plr].Color = col
						espTracers[plr].Visible = true
					end
				end
			end
		end
		for plr, box in pairs(espBoxes) do
			if not current[plr] then
				pcall(function() box:Remove() end)
				espBoxes[plr] = nil
				if espTracers[plr] then pcall(function() espTracers[plr]:Remove() end) espTracers[plr] = nil end
			end
		end
	end
end)

-- Hitbox sin congelar
RunService.Heartbeat:Connect(function()
	local char = LocalPlayer.Character
	if not char then return end
	if char:FindFirstChild("Humanoid") then
		char.Humanoid.WalkSpeed = currentSpeed
	end
	if noclipEnabled then
		for _, p in pairs(char:GetDescendants()) do
			if p:IsA("BasePart") then p.CanCollide = false end
		end
	end

	if hitboxEnabled then
		for _, plr in pairs(Players:GetPlayers()) do
			if isEnemy(plr) and plr.Character then
				local root = plr.Character:FindFirstChild("HumanoidRootPart")
				if root then
					if not originalSizes[plr] then
						originalSizes[plr] = {
							root = root.Size,
							rootTrans = root.Transparency
						}
					end
					-- Solo tamaño y transparencia, sin tocar física
					root.Size = Vector3.new(hitboxSize, hitboxSize * 1.15, hitboxSize)
					root.Transparency = 0.85
					root.CanCollide = false
				end
			end
		end
	end
end)

